{
  "manifest_version": 3,
  "name": "Smart QA Test Case Creator",
  "version": "1.0.0",
  "description": "Persistent QA test run recorder with smart element capture",
     "externally_connectable": {
        "matches": [
          "http://localhost/*",
          "http://3.7.136.248/*"
        ]
      },

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "windows",
    "sidePanel"
  ],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background/service-worker.js"
  },

  "action": {
    "default_title": "Open QA Recorder",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },

  "side_panel": {
    "default_path": "popup/flow.html"
  },

  "commands": {
    "toggle-verification": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "Toggle Verification Mode"
    },
    "toggle-hover": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Toggle Hover Mode"
    },
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "Toggle Pause/Resume"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Open/Close Extension Side Panel"
    }
  },

  "web_accessible_resources": [
    {
      "resources": ["popup/popup.html", "popup/popup.css", "popup/popup.js",
                    "popup/flow.html", "popup/flow.css", "popup/flow.js",
                    "scenario-builder/schema.js", "storage/storage.js",
                    "api/api-client.js", "content/ui-injector.css", "assets/*.png"],
      "matches": ["<all_urls>"]
    }
  ],

  "content_scripts": [],

  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
